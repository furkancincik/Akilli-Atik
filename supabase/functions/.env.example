# Copy to supabase/functions/.env for local serving only; never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANALYSIS_ENABLED=false
# Keep test until the quota migration is approved/applied and normal flow verified.
ANALYSIS_ACCESS_MODE=test
ANALYSIS_TEST_TOKEN=
# ISO UTC timestamp; the outer server deadline allows at most 10 minutes.
ANALYSIS_TEST_EXPIRES_AT=
# Set your project's public publishable/anon key only if not provided by runtime.
ANALYSIS_PUBLIC_KEY=
# Runtime supplies these in a deployed Edge Function. Local serving uses only
# this project's server credentials; never prefix service-role values with VITE_.
SUPABASE_URL=https://nyoxbwandadakfagoner.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=https://localhost,http://localhost,capacitor://localhost,http://localhost:5173
