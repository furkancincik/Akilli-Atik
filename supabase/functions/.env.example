# Copy to supabase/functions/.env for local serving only; never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANALYSIS_ENABLED=false
ANALYSIS_TEST_TOKEN=
# ISO UTC timestamp; live window must be at most 15 minutes ahead.
ANALYSIS_TEST_EXPIRES_AT=
# Set your project's public publishable/anon key only if not provided by runtime.
ANALYSIS_PUBLIC_KEY=
ALLOWED_ORIGINS=https://localhost,http://localhost,capacitor://localhost,http://localhost:5173,http://127.0.0.1:5173
