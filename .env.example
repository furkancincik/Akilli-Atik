# Yalnızca Supabase proje URL'si ve herkese açık publishable/anon anahtarı.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Normal kullanıcı arayüzü; bu public ayar sunucuda analizi açmaz.
# Eski süreli pilotun kod alanı için test seçilebilir.
VITE_ANALYSIS_ACCESS_MODE=authenticated
# Gemini ve Supabase secret/service_role anahtarlarını buraya EKLEMEYİN.
# GEMINI_API_KEY yalnız Supabase Edge Function secret olarak saklanır.
